{
	"schemaVersion": 1,
	"id": "nexvior",
	"version": "${version}",
	"name": "NexVior Client",
	"description": "A lightweight, PvP-focused HUD and utility mod built for compatibility with Sodium, Lithium, and Iris.",
	"authors": [
		"NexVior"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/nexvior/textures/gui/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.nexvior.client.NexViorClient"
		],
		"modmenu": [
			"com.nexvior.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"nexvior.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"fabric-api": "*",
		"minecraft": "1.21.11",
		"java": ">=21"
	},
	"suggests": {
		"modmenu": "*"
	}
}
